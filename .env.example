# --- required ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=

# --- optional ---
# Proxy for Telegram and the Claude API only (e.g. http://127.0.0.1:8080 or socks5://host:1080).
# Codal and TSETMC are always reached directly.
OUTBOUND_PROXY=
# host: needed when OUTBOUND_PROXY is on the host's 127.0.0.1 (otherwise keep bridge)
NETWORK_MODE=bridge
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# --- schedule (Tehran time, TZ) ---
# false: no scheduled runs; run by hand with `docker compose exec fis-bot python -m app.pipeline`
SCHEDULER_ENABLED=true
# cron expression: minute hour day month weekday (weekday 0 = Sunday, 6 = Saturday)
# 0 15 * * *       every day at 15:00
# 0 */6 * * *      every 6 hours (00, 06, 12, 18)
# 30 9,15 * * 6-3  09:30 and 15:30, Saturday to Wednesday
CRON_SCHEDULE=0 15 * * *
# also run once when the container starts
RUN_ON_START=false
# send a short message on days without new reports
SEND_WHEN_NO_CHANGE=false
# re-evaluate holdings (NAV) on update days
RUN_HOLDINGS=true
# listed companies not yet in the workbook added per run, until the whole market is covered (0 = off)
BACKFILL_PER_DAY=30
# how many days back to look on the very first run
LOOKBACK_DAYS=2
KEEP_EXCEL_FILES=30
# when Codal throttles us the run stops (progress is kept) and continues after this many minutes
# (0 = continue at the next scheduled run)
RESUME_AFTER_MINUTES=1
# a market-wide Codal search is reused for this long, so a resumed run does not search again
WATCH_SEARCH_TTL_SECONDS=72000
# build only: PyPI mirror and/or a proxy for pip. The build uses NETWORK_MODE too, so with
# NETWORK_MODE=host a proxy on the host's 127.0.0.1 works; with bridge use e.g. http://172.17.0.1:1080
BUILD_PROXY=
PIP_INDEX_URL=https://pypi.org/simple
# host user that owns ./data (run `id -u` / `id -g`)
APP_UID=1000
APP_GID=1000
